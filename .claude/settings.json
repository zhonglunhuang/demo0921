{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./scripts/agent-status.sh)",
      "Bash(scripts/agent-status.sh)",
      "Bash(./scripts/ticket-lint.sh)",
      "Bash(scripts/ticket-lint.sh)",
      "Bash(./scripts/new-ticket.sh:*)",
      "Bash(scripts/new-ticket.sh:*)",
      "Bash(make check)",
      "Bash(make ticket-lint)",
      "Bash(make new-ticket:*)"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/ticket-gate-hook.sh",
            "statusMessage": "檢查無票不開發閘門",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/git-sync-gate-hook.sh",
            "statusMessage": "推分支前檢查遠端同步",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/session-start-hook.sh"
          }
        ]
      }
    ]
  }
}
